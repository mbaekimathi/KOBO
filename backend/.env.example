DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Keep False for PyMySQL / MySQL (`KOBO COLLECT`).
# SQLite is a temporary fallback only — it does not scale to many concurrent writers.
USE_SQLITE=False

DB_NAME=KOBO COLLECT
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10
SQLITE_TIMEOUT=30

CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Concurrent serving (Waitress)
WSGI_HOST=127.0.0.1
WSGI_PORT=8001
WSGI_THREADS=16

# Optional shared cache for multi-process deploys (leave empty for in-process LocMem)
# REDIS_URL=redis://127.0.0.1:6379/1

JWT_ACCESS_HOURS=8
JWT_REFRESH_DAYS=7
DRF_THROTTLE_ANON=120/min
DRF_THROTTLE_USER=600/min
